UVICORN_WORKERS=1
DATABASE_USER_ACTIVE_STATUS_UPDATE_INTERVAL=300

ENABLE_ADMIN_CHAT_ACCESS=false
BYPASS_ADMIN_ACCESS_CONTROL=false
